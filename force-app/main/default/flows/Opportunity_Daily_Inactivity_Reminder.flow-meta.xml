        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>DaysWithoutActivity</name>
        <dataType>Number</dataType>
        <expression>TODAY() - BLANKVALUE( {!$Record.LastActivityDate}, DATEVALUE( {!$Record.CreatedDate} ) )</expression>
        <scale>0</scale>
    </formulas>
