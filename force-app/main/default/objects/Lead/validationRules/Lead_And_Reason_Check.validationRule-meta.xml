<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_And_Reason_Check</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISNEW()),
  ISPICKVAL(Status, &quot;Unqualified&quot;),
  ISBLANK(Reason__c)
)</errorConditionFormula>
    <errorMessage>When a lead is marked Unqualified, Reason is required, but the rule must not fire for new or cloned records</errorMessage>
</ValidationRule>
