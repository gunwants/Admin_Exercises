<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>email_not_endwith</fullName>
    <active>true</active>
    <description>email should not end with 
.games
.garden
.glass
.free
.talk</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Email)),
    OR(
        REGEX(LOWER(Email), &quot;.*\\.(games|garden|glass|free|talk)$&quot;),
        REGEX(LOWER(Email), &quot;^(info@|contact@|career@).*&quot;)
    )
)</errorConditionFormula>
    <errorDisplayField>Email</errorDisplayField>
    <errorMessage>Invalid Email Address: Domain extensions (.games, .garden, .glass, .free, .talk) and generic email prefixes (info@, contact@, career@) are not allowed.</errorMessage>
</ValidationRule>
