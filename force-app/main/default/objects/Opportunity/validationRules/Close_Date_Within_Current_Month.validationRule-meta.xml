<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Close_Date_Within_Current_Month</fullName>
    <active>true</active>
    <description>Close Date must fall within the current month.</description>
    <errorConditionFormula>OR(
  MONTH(CloseDate) &lt;&gt; MONTH(TODAY()),
  YEAR(CloseDate) &lt;&gt; YEAR(TODAY())
)</errorConditionFormula>
    <errorDisplayField>CloseDate</errorDisplayField>
    <errorMessage>Close Date must fall within the current month.</errorMessage>
</ValidationRule>
